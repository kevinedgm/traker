# Variables públicas del build. Copia este archivo a .env.local y sustituye
# únicamente con valores del proyecto autorizado para el entorno.
VITE_API_URL=/api
VITE_SYNC_V2_PILOT=false
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_staging_key
VITE_SUPABASE_REQUEST_TIMEOUT_MS=15000
# Web Push (public half of the VAPID pair; the private half lives ONLY in
# Supabase secrets: supabase secrets set VAPID_PRIVATE_KEY <valor>)
VITE_VAPID_PUBLIC_KEY=
